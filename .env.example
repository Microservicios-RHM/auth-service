PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

DB_HOST=localhost
DB_PORT=5436
DB_NAME=auth_db
DB_SCHEMA=auth
DB_USER=auth_service
DB_PASSWORD=change_auth_password
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY_MS=1000

JWT_SECRET=change_this_jwt_secret
JWT_ISSUER=auth-service
JWT_ACCESS_TTL_SECONDS=3600
JWT_RESET_TTL_SECONDS=900

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=change_admin_password

BROKER_URL=amqp://admin:admin@localhost:5672
BROKER_EXCHANGE=rhm.events
BROKER_QUEUE=auth.queue
BROKER_CONNECT_MAX_ATTEMPTS=5
BROKER_CONNECT_RETRY_DELAY_MS=1000
