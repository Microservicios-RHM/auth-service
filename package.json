{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Microservicio de autenticación y ciclo de vida de cuentas",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start:dist": "node dist/server.js",
    "db:migrate": "node src/infrastructure/persistence/postgres/migrations/migration.runner.ts",
    "db:migrate:dist": "node dist/infrastructure/persistence/postgres/migrations/migration.runner.js",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage tests/**/*.test.ts",
    "test:ci": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-lines=70 --test-coverage-include=\"src/application/use-cases/login.use-case.ts\" --test-coverage-include=\"src/domain/password-policy.ts\" tests/**/*.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "amqplib": "^0.10.5",
    "bcryptjs": "^3.0.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.6",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
